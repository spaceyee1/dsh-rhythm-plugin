<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="插件开关" Width="148" Height="48" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Border x:Name="PluginSwitch" Margin="4" Padding="12,8" CornerRadius="10"
          Background="#F0FAFDF7" BorderBrush="#C8DCCE" BorderThickness="1">
    <CheckBox x:Name="PluginToggle" Content="是否开启插件" IsChecked="False"
              FontSize="12" Foreground="#334D40" Cursor="Hand" VerticalContentAlignment="Center"/>
  </Border>
</Window>
